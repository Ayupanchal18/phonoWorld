# ==============================================================================
# PhonoWorld Platform - Environment Configuration Template
# ==============================================================================

# 1. CORE SERVER CONFIGURATION
PORT=5000
NODE_ENV=production
CORS_ORIGIN=*
JWT_SECRET=your_jwt_secret_change_in_production_987654321

# 2. DATABASE CONFIGURATION (OPTIONAL)
# If left empty, PhonoWorld automatically operates using its built-in high-performance in-memory repository
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/phonoworld?retryWrites=true&w=majority

# 3. AMAZON PA-API 5.0 LIVE PRICING (OPTIONAL)
# If omitted, PhonoWorld uses verified canonical Indian baseline prices in sandbox mode
AMAZON_PAAPI_KEY=
AMAZON_PAAPI_SECRET=
AMAZON_ASSOCIATE_TAG=phonoworld-21
AMAZON_HOST=webservices.amazon.in
AMAZON_REGION=eu-west-1

# 4. AFFILIATE NETWORK FEEDS (OPTIONAL)
# CUELINKS_PUB_ID=
# CUELINKS_API_KEY=

# 5. CACHE & PERFORMANCE (OPTIONAL)
# If omitted, in-memory LRU cache with sub-5ms latency is used automatically
# REDIS_URL=redis://default:password@your-redis-host:6379
